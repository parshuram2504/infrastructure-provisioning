pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select deployment environment'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'ap-south-1',
            description: 'AWS region'
        )

        string(
            name: 'AMI_ID',
            defaultValue: '',
            description: 'AMI ID'
        )

        choice(
            name: 'INSTANCE_TYPE',
            choices: ['t2.micro', 't3.micro', 't3.small'],
            description: 'Select EC2 instance type'
        )

        string(
            name: 'INSTANCE_NAME',
            defaultValue: 'dev-server',
            description: 'EC2 instance name'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AWS Authentication Test') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'jenkins-aws']
                ]) {
                    sh '''
                        echo "===== AWS Identity ====="
                        aws sts get-caller-identity
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh '''
                        terraform init
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh '''
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'jenkins-aws']
                ]) {
                    dir('terraform') {
                        sh """
                            terraform plan \
                            -var="aws_region=${params.AWS_REGION}" \
                            -var="ami_id=${params.AMI_ID}" \
                            -var="instance_type=${params.INSTANCE_TYPE}" \
                            -var="instance_name=${params.INSTANCE_NAME}" \
                            -var="environment=${params.ENVIRONMENT}"
                        """
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'jenkins-aws']
                ]) {
                    dir('terraform') {
                        sh """
                            terraform apply -auto-approve \
                            -var="aws_region=${params.AWS_REGION}" \
                            -var="ami_id=${params.AMI_ID}" \
                            -var="instance_type=${params.INSTANCE_TYPE}" \
                            -var="instance_name=${params.INSTANCE_NAME}" \
                            -var="environment=${params.ENVIRONMENT}"
                        """
                    }
                }
            }
        }

        stage('Terraform Output') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'jenkins-aws']
                ]) {
                    dir('terraform') {
                        sh '''
                            echo "===== TERRAFORM OUTPUT =====" > instance-details.txt

                            terraform output >> instance-details.txt

                            echo "" >> instance-details.txt
                            echo "===== AWS INSTANCE DETAILS =====" >> instance-details.txt

                            INSTANCE_ID=$(terraform output -raw instance_id)

                            aws ec2 describe-instances \
                                --instance-ids "$INSTANCE_ID" \
                                --region "$AWS_REGION" \
                                --query 'Reservations[0].Instances[0].{
                                    InstanceId:InstanceId,
                                    InstanceType:InstanceType,
                                    State:State.Name,
                                    AvailabilityZone:Placement.AvailabilityZone,
                                    PrivateIP:PrivateIpAddress,
                                    PublicIP:PublicIpAddress,
                                    VPC:VpcId,
                                    Subnet:SubnetId,
                                    AMI:ImageId,
                                    Name:Tags[?Key==`Name`].Value|[0],
                                    Environment:Tags[?Key==`Environment`].Value|[0]
                                }' \
                                --output table >> instance-details.txt

                            echo "" >> instance-details.txt
                            echo "===== AWS REGION =====" >> instance-details.txt

                            echo "$AWS_REGION" >> instance-details.txt

                            echo ""
                            echo "===== INSTANCE DETAILS ====="
                            cat instance-details.txt
                        '''
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'terraform/instance-details.txt',
                        fingerprint: true
                    )

                    archiveArtifacts(
                        artifacts: 'terraform/terraform.tfstate',
                        fingerprint: true
                    )
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}